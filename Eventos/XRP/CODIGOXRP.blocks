from XRPLib.board import Board
from XRPLib.webserver import Webserver
from XRPLib.encoded_motor import EncodedMotor

board = Board.get_default_board()

webserver = Webserver.get_default_webserver()

motor1 = EncodedMotor.get_default_encoded_motor(1)

motor2 = EncodedMotor.get_default_encoded_motor(2)


board.wait_for_button()

def func394():
  motor1._motor.flip_dir = (True)
  motor2._motor.flip_dir = (False)
  motor1.set_speed(60)
  motor2.set_speed(60)

webserver.registerForwardButton(func394)

def func395():
  motor1._motor.flip_dir = (False)
  motor2._motor.flip_dir = (True)
  motor1.set_speed(60)
  motor2.set_speed(60)

webserver.registerBackwardButton(func395)

def func396():
  motor1._motor.flip_dir = (False)
  motor2._motor.flip_dir = (False)
  motor1.set_speed(60)
  motor2.set_speed(60)

webserver.registerLeftButton(func396)

def func397():
  motor1._motor.flip_dir = (True)
  motor2._motor.flip_dir = (True)
  motor1.set_speed(60)
  motor2.set_speed(60)

webserver.registerRightButton(func397)

def func398():
  motor1.set_speed()
  motor2.set_speed()

webserver.registerStopButton(func398)
webserver.log_data("johan puto", 'peque putito')
webserver.start_network(ssid="BARCELONA DE ECUADOR", password="87654321")
webserver.start_server()
webserver.connect_to_network(ssid="BARCELONA DE ECUADOR", password="87654321")
webserver.start_server()



